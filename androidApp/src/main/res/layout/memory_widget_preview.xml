<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para el selector de widgets, que infla RemoteViews y no sabe de Glance. Ensena el nombre y
  ninguna linea: el selector no es sitio para el diario de nadie.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/widget_background"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_memory_name"
        android:textColor="@color/widget_on_background"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_memory_description"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
